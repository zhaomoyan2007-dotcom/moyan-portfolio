# Set real values in Vercel environment variables. Never commit a filled .env file.
SITE_URL=
GITHUB_REPOSITORY=
GITHUB_BRANCH=main
GITHUB_OWNER=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_STATE_SECRET=
# Private repositories require repo; public-only repositories can use public_repo.
GITHUB_OAUTH_SCOPE=public_repo
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Server-only. Never expose this secret in the CMS configuration.
CLOUDINARY_API_SECRET=
